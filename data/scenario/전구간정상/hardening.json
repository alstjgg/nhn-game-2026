  "symptoms": {
    "defensiveness": {
      "up": [
        {
          "min": 20,
          "text": "하만식이 의자를 화면 쪽으로 돌려 앉는다 — 등만 보인다. 무엇을 물어도 절차서 쪽수부터 읽는다"
        },
        {
          "min": 10,
          "text": "하만식이 대답 대신 상황판을 손끝으로 두드린다 — 여기 정상으로 떠 있지 않냐고"
        },
        {
          "min": 1,
          "text": "하만식의 손이 마우스에서 떨어지지 않는다"
        }
      ],
      "down": [
        {
          "min": 20,
          "text": "하만식이 헤드셋을 벗어 책상에 내려놓고, 차단이 늦은 시간을 제 입으로 읽는다 — 열한 분"
        },
        {
          "min": 10,
          "text": "하만식의 말끝이 흐려지다 제가 언제 눌렀는지까지 온다"
        },
        {
          "min": 1,
          "text": "하만식의 문장에서 규정상이라는 말이 빠졌다"
        }
      ]
    },
    "dread": {
      "up": [
        {
          "min": 20,
          "text": "차우진의 말이 토막 나 흩어지고, 발소리가 송화구에서 멀어진다 — 차를 두고 뛰는 소리다"
        },
        {
          "min": 10,
          "text": "차우진이 같은 말을 두 번 되풀이한다. 문 여는 소리, 곧 닫는 소리"
        },
        {
          "min": 1,
          "text": "차우진의 숨이 송화구에 걸린다"
        }
      ],
      "down": [
        {
          "min": 20,
          "text": "차우진이 숨을 고르고 문장을 끝까지 맺는다 — 적재함에 무엇을 실었는지까지"
        },
        {
          "min": 10,
          "text": "차우진의 말 사이 간격이 고르게 벌어진다. 묻는 것에만 답한다"
        },
        {
          "min": 1,
          "text": "차우진이 말하기 전에 한 번 숨을 들이쉰다"
        }
      ]
    },
    "trust": {
      "up": [
        {
          "min": 20,
          "text": "오세라가 되묻지 않고 움직인다 — 시킨 자리까지 발소리가 끊기지 않고 이어진다"
        },
        {
          "min": 10,
          "text": "오세라가 알겠다는 말 뒤에 제가 본 것을 덧붙인다 — 묻지 않은 것까지"
        },
        {
          "min": 1,
          "text": "오세라가 회선을 끊지 않고 붙들고 있다"
        }
      ],
      "down": [
        {
          "min": 20,
          "text": "오세라의 발소리가 멎는다 — 거기 누가 있는 거냐고 회선에 대고 묻는다"
        },
        {
          "min": 10,
          "text": "오세라가 지시를 받을 때마다 그 근거를 되묻는다"
        },
        {
          "min": 1,
          "text": "오세라의 대답이 한 박자 늦어진다"
        }
      ]
    },
