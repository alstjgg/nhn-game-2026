{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timeline.schema.json",
  "title": "datapack timeline.json — 무개입 고정 타임라인",
  "description": "무개입 시 항상 같은 시각에 일어나는 사건만 싣는다. 갈림길의 선택으로만 나타나는 사건(분기 전용)은 gates.json의 branch_note 산문에 남고 타임라인에는 없다.",
  "type": "object",
  "required": ["events"],
  "additionalProperties": false,
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "time", "surface", "text", "exposure"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^t[0-9]+$" },
          "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]\\+?$" },
          "surface": {
            "enum": ["call", "cctv", "onsite", "document"],
            "description": "사건이 관측되는 표면 — 통화 / CCTV / 현장 / 문서·기록 화면"
          },
          "place_id": {
            "type": ["string", "null"],
            "description": "places.json의 장소 id. 특정 장소에 속하지 않으면 null"
          },
          "text": { "type": "string", "minLength": 1, "description": "사건 서술 원문 — 채굴 광맥이 되는 문장" },
          "exposure": {
            "type": "object",
            "required": ["visible_from"],
            "additionalProperties": false,
            "properties": {
              "visible_from": {
                "type": ["string", "null"],
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]\\+?$",
                "description": "이 시계까지 생존한 런에만 보인다. null = 초반 런에도 보임"
              },
              "extra_condition": {
                "type": ["string", "null"],
                "description": "시계 외 추가 노출 조건의 자유 서술(예: 현장을 들여다본 런). 하드닝 시 술어로 승격 — 린트가 미완 플래그를 단다"
              }
            }
          }
        }
      }
    }
  }
}
