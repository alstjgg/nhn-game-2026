  "symptoms": {
    "evasion": {
      "up": [
        {
          "min": 20,
          "text": "서정민이 접수대장을 통째로 밀어 놓고, 전임자 서명란을 손톱으로 짚어 보인다."
        },
        {
          "min": 10,
          "text": "과장 번호를 다시 누르면서, 통화 기록 화면을 켜 둔 채로 신호를 센다."
        },
        {
          "min": 1,
          "text": "펜을 들었다가 결재란 위에서 한 박자 멈춘다."
        }
      ],
      "down": [
        {
          "min": 20,
          "text": "서정민이 당직 일지에 자기 이름을 적고, 통제 요청을 직접 무전으로 읽어 내린다."
        },
        {
          "min": 10,
          "text": "수화기를 내려놓고 도면부터 편다. 맨홀 위치에 손가락을 박아 둔다."
        },
        {
          "min": 1,
          "text": "'확인해 보겠습니다'가 '제가 가 보겠습니다'로 바뀐다."
        }
      ]
    },
    "grievance": {
      "up": [
        {
          "min": 20,
          "text": "최두일이 좌판을 맨홀 앞으로 끌어다 놓고 그 위에 올라서서, 들어오는 차를 향해 팔을 젓는다."
        },
        {
          "min": 10,
          "text": "삼 년 전 접수증을 꺼내 사람들 앞에 펴 들고, 같은 말을 두 번 한다."
        },
        {
          "min": 1,
          "text": "말끝이 짧아지고, 묻지 않은 대답이 먼저 나온다."
        }
      ],
      "down": [
        {
          "min": 20,
          "text": "최두일이 좌판을 접어 인도 안쪽으로 밀고, 물가로 붙는 사람들 팔을 하나씩 떼어 놓는다."
        },
        {
          "min": 10,
          "text": "쥐고 있던 접수증을 접어 주머니에 넣고, 묻는 순서대로 답한다."
        },
        {
          "min": 1,
          "text": "말하다 말고 한 번 숨을 고른다. 목소리가 반 톤 내려간다."
        }
      ]
    },
    "composure": {
      "up": [
        {
          "min": 20,
          "text": "강미르가 벽에 붙은 표지 글자를 또박또박 읽어 주고, 끝에 '이상'을 붙인다."
        },
        {
          "min": 10,
          "text": "말과 말 사이에 숨 쉬는 자리가 돌아온다. 물이 허리께라고 짚어 준다."
        },
        {
          "min": 1,
          "text": "대답하는 목소리가 중간에 끊기지 않는다."
        }
      ],
      "down": [
        {
          "min": 20,
          "text": "강미르가 같은 문장을 세 번째 되풀이한다. '작업자는 즉시 상급자에게 보고한다.' 물소리가 말을 반쯤 덮는다."
        },
        {
          "min": 10,
          "text": "말이 붙어 나오고, 무전 끝을 맺지 못한 채 손을 뗀다."
        },
        {
          "min": 1,
          "text": "숨소리가 목소리보다 먼저 마이크에 닿는다."
        }
      ]
    },
    "flags": {
      "reclassified": {
        "set": "접수 항목의 하수도 막힘 칸에 줄이 그어지고, 구조물 이상 칸에 다시 적힌다."
      },
      "road_closed": {
