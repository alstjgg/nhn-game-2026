{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-record.schema.json",
  "title": "run-record — 끝난 런이 남기는 것 (pipeline §6)",
  "description": "데이터 트랙은 런이 남기는 표면만 묶는다 — 엔진 내부는 엔진 소유. 공급자는 전부 기존 계약이 정한다: 비트·stance·utterance는 콜 계약 §2, delta journal은 엔진 요청서 §4, 두 보고서는 콜 계약 §4, timeline은 §6 데이터 흐름.",
  "type": "object",
  "required": ["run_id", "pack_slug", "policy", "reached_clock", "injected_blocks", "beats", "timeline", "reports", "score"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "pack_slug": { "type": "string", "minLength": 1 },
    "policy": {
      "type": ["string", "null"],
      "description": "정책 봇 이름(random | greedy | oracle …). 사람 플레이는 null"
    },
    "reached_clock": {
      "$ref": "#/$defs/clockTime",
      "description": "이 런이 도달한 시계 깊이. ⚠ 런 종료 조건 자체는 엔진 미결(요청서 §6) — 의미는 엔진 명세 회신과 함께 확정"
    },
    "injected_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "mined_from_run"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1, "description": "주입 문장 원문 — 실제 생성/스크립트 텍스트에서 채굴 (W3)" },
          "mined_from_run": { "type": ["string", "null"], "description": "채굴된 런의 run_id. 스크립트 타임라인 채굴이면 null" }
        }
      }
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["beat", "clock", "gate", "stance", "deltas"],
        "additionalProperties": false,
        "properties": {
          "beat": { "type": "integer", "minimum": 1 },
          "clock": { "anyOf": [{ "$ref": "#/$defs/clockTime" }, { "type": "null" }] },
          "gate": { "type": ["string", "null"], "pattern": "^G[0-9]+$", "description": "이 비트가 게이트 비트가 아니면 null" },
          "stance": { "type": ["string", "null"], "description": "Call 1 출력 stance id. 게이트 비트가 아니면 null" },
          "deltas": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["variable", "before", "after", "cause"],
              "additionalProperties": false,
              "properties": {
                "variable": { "type": "string", "minLength": 1 },
                "before": { "type": "number" },
                "after": { "type": "number" },
                "cause": { "type": "string", "minLength": 1 }
              }
            },
            "description": "비트별 delta journal — 엔진 요청서 §4의 형태 그대로. attributability의 근거"
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "렌더된 타임라인 줄 전부(고정 사건 + 통제관 발화 + Call 2 출력) — 채굴 표면(W2)"
    },
    "reports": {
      "type": "object",
      "required": ["facts", "report_body"],
      "additionalProperties": false,
      "properties": {
        "facts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "객관 기록 (Call 3)" },
        "report_body": { "type": "string", "minLength": 1, "description": "자필 보고서 (Call 3) — 채굴 표면(W3)" }
      }
    },
    "score": {
      "type": ["object", "null"],
      "description": "종료 시계에서 score.json 평가 결과. 종료 시계 미도달 런이 존재하는지는 엔진 미결 — null 허용은 그 보류",
      "required": ["units", "total"],
      "additionalProperties": false,
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "value"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^u[0-9]+$" },
              "value": { "type": ["string", "number"] }
            }
          }
        },
        "total": { "type": ["number", "null"] }
      }
    }
  },
  "$defs": {
    "clockTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]\\+?$" }
  }
}
