{
  "name": "doodle-life-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "eval:record": "tsx scripts/evaluate.mts",
    "eval:request-first": "tsx scripts/evaluate-request-first.mts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
