# The browser never receives this key. Keep it only in the local server environment.
OPENAI_API_KEY=

# Leave blank to fall through to the repository .env.local, then use OpenAI
# when a key exists or deterministic mock when it does not. Use `auto` to
# explicitly force automatic selection over a root AI_PROVIDER value.
# Supported explicit values: openai (alias: api), mock.
AI_PROVIDER=
# Legacy /api/v1 evaluation only. The request-first /api/v2 browser flow does
# not use autonomy modes.
AI_AUTONOMY=
AI_PORT=8787
AI_TIMEOUT_MS=180000
AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SERVER_REQUEST_TIMEOUT_MS=660000
VITE_AI_CLIENT_TIMEOUT_MS=720000

# Override per role after measuring quality and cost. Defaults live in server/ai/provider.ts.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_WORLD_AUTHOR=gpt-5.6-terra
OPENAI_MODEL_DOODLE_VISION=gpt-5.6-sol
OPENAI_MODEL_NPC_MIND=gpt-5.6-terra
OPENAI_MODEL_WORLD_DIRECTOR=gpt-5.6-sol
OPENAI_MODEL_CONTINUITY_CRITIC=gpt-5.6-terra
OPENAI_MODEL_DIALOGUE_WRITER=gpt-5.6-terra
OPENAI_MODEL_WORLD_AND_QUEST_AUTHOR=gpt-5.6-terra
OPENAI_MODEL_DOODLE_READER=gpt-5.6-sol
OPENAI_MODEL_QUEST_OWNER_REACTION=gpt-5.6-terra
OPENAI_MODEL_QUEST_OBSERVER_REACTION=gpt-5.6-terra

# Optional evaluation overrides. A role-specific value wins over the global value.
# Supported reasoning values in this demo are low and medium.
OPENAI_REASONING_EFFORT=
OPENAI_REASONING_EFFORT_WORLD_AUTHOR=
OPENAI_REASONING_EFFORT_DOODLE_VISION=
OPENAI_REASONING_EFFORT_NPC_MIND=
OPENAI_REASONING_EFFORT_WORLD_DIRECTOR=
OPENAI_REASONING_EFFORT_CONTINUITY_CRITIC=
OPENAI_REASONING_EFFORT_DIALOGUE_WRITER=
OPENAI_REASONING_EFFORT_WORLD_AND_QUEST_AUTHOR=
OPENAI_REASONING_EFFORT_DOODLE_READER=
OPENAI_REASONING_EFFORT_QUEST_OWNER_REACTION=
OPENAI_REASONING_EFFORT_QUEST_OBSERVER_REACTION=
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_MAX_OUTPUT_TOKENS_WORLD_AUTHOR=
OPENAI_MAX_OUTPUT_TOKENS_DOODLE_VISION=
OPENAI_MAX_OUTPUT_TOKENS_NPC_MIND=
OPENAI_MAX_OUTPUT_TOKENS_WORLD_DIRECTOR=
OPENAI_MAX_OUTPUT_TOKENS_CONTINUITY_CRITIC=
OPENAI_MAX_OUTPUT_TOKENS_DIALOGUE_WRITER=
OPENAI_MAX_OUTPUT_TOKENS_WORLD_AND_QUEST_AUTHOR=
OPENAI_MAX_OUTPUT_TOKENS_DOODLE_READER=
OPENAI_MAX_OUTPUT_TOKENS_QUEST_OWNER_REACTION=
OPENAI_MAX_OUTPUT_TOKENS_QUEST_OBSERVER_REACTION=
