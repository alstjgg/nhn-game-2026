{
  "name": "apothecary-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lambda": "vite --mode lambda --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve:ai": "node server/standalone.mjs",
    "test": "vitest run tests/",
    "test:e2e": "playwright test",
    "test:e2e:lambda": "playwright test --config playwright.lambda.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
