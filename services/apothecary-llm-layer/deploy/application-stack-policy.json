{
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "Update:*",
      "Principal": "*",
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": [
        "Update:Replace",
        "Update:Delete"
      ],
      "Principal": "*",
      "Resource": [
        "LogicalResourceId/HttpApiAccessLogGroup",
        "LogicalResourceId/LlmExecutionRole",
        "LogicalResourceId/LlmHttpApi",
        "LogicalResourceId/LlmHttpApiApiGatewayDefaultStage",
        "LogicalResourceId/TurnFunction",
        "LogicalResourceId/TurnFunctionLogGroup"
      ]
    }
  ]
}
