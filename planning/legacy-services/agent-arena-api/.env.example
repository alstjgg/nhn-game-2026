# Local server
ARENA_HOST=127.0.0.1
ARENA_PORT=8790
ARENA_API_KEYS=
ARENA_DATABASE_URL=file:./data/agent-arena.sqlite
ARENA_CONTEXT_ENCRYPTION_KEY=
ARENA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ARENA_MAX_BODY_BYTES=262144
ARENA_RATE_LIMIT_PER_MINUTE=120

# Provider profiles remain unavailable until both the key and model are set.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# One reviewed custom Skill uploaded separately to each provider.
OPENAI_SKILL_ID=
OPENAI_SKILL_VERSION=
ANTHROPIC_SKILL_ID=
ANTHROPIC_SKILL_VERSION=

# One read-only remote MCP server shared by both provider profiles.
ARENA_CALCULATOR_MCP_URL=
ARENA_CALCULATOR_MCP_TOKEN=

# Explicit live-test gate.
RUN_LIVE=0
LIVE_TEST_PROVIDER=all
LIVE_TEST_SCENARIO_SET=all
LIVE_TEST_MAX_OUTPUT_TOKENS=96
LIVE_TEST_CAPABILITY_MAX_OUTPUT_TOKENS=384
BOOTSTRAP_LIVE_SKILLS=0
BOOTSTRAP_LIVE_SKILLS_FORCE_VERSION=0
BOOTSTRAP_LIVE_SKILLS_ALLOW_UNVERIFIED_REUSE=0
