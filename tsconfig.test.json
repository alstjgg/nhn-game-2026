{
  /*
   * Type-checks the test harness only. `tsconfig.json` (include: ["src"]) is the
   * product build and stays untouched; this config adds Node globals for the
   * structural suites and the two runner configs. No `paths` — the repo resolves
   * by relative specifier everywhere (physical §3.2).
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "esModuleInterop": true
  },
  "include": ["tests", "e2e", "vitest.config.ts", "playwright.config.ts"]
}
